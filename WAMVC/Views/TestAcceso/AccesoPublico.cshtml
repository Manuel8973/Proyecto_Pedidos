@{
    ViewData["Title"] = "Acceso Público";
}

<div class="text-center">
    <div class="alert alert-success">
      <h3><i class="bi bi-globe"></i> ¡Acceso Público!</h3>
     <p>Esta página es accesible para <strong>cualquier usuario</strong>, incluso sin autenticar.</p>
     @if (User.Identity.IsAuthenticated)
  {
   <p>Estás autenticado como: <strong>@User.Identity.Name</strong></p>
 }
    else
  {
     <p>No estás autenticado (usuario anónimo)</p>
      }
   </div>
  
 <a asp-action="Index" class="btn btn-primary">Volver a Pruebas</a>
</div>