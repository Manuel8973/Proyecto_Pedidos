@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row">
    <div class="col-md-8 offset-md-2 text-center">
        <div class="card border-danger">
      <div class="card-header bg-danger text-white">
    <h4><i class="bi bi-shield-x"></i> Acceso Denegado</h4>
</div>
      <div class="card-body">
     <div class="mb-4">
       <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
        </div>
      
        <h5 class="text-danger">No tienes permisos para acceder a esta página</h5>
       <p class="text-muted">
  Tu nivel de acceso actual no te permite ver este contenido. 
        Si crees que esto es un error, contacta al administrador del sistema.
            </p>

     <hr>

      <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
       <i class="bi bi-house"></i> Ir al Inicio
      </a>
       
   @if (User.Identity.IsAuthenticated)
      {
     <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
          <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
        </a>
        }
     else
       {
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
       <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
  </a>
       }
     </div>

       @if (User.Identity.IsAuthenticated)
   {
     <div class="mt-3">
       <small class="text-muted">
       Usuario actual: <strong>@User.Identity.Name</strong> | 
      Rol: <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong>
     </small>
          </div>
     }
            </div>
     </div>
 </div>
</div>