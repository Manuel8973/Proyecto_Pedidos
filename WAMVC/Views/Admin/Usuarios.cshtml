@model IEnumerable<WAMVC.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2><i class="bi bi-people"></i> Gestión de Usuarios</h2>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">
       <i class="bi bi-speedometer2"></i> Volver al Dashboard
            </a>
 </div>

        @if (TempData["SuccessMessage"] != null)
        {
     <div class="alert alert-success alert-dismissible fade show" role="alert">
           <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
           <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
       <h5 class="mb-0">Lista de Usuarios del Sistema</h5>
    </div>
 <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
         <thead class="table-dark">
        <tr>
           <th>ID</th>
          <th>Email</th>
          <th>Rol</th>
            <th>Estado</th>
       <th>Acciones</th>
        </tr>
              </thead>
      <tbody>
   @foreach (var usuario in Model)
   {
        <tr>
  <td>@usuario.Id</td>
          <td>@usuario.Email</td>
               <td>
         <span class="badge bg-@(usuario.Rol == "Admin" ? "danger" : usuario.Rol == "Empleado" ? "warning" : "info")">
    @usuario.Rol
             </span>
       </td>
   <td>
              @if (usuario.Activo)
      {
   <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activo</span>
           }
     else
         {
     <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Inactivo</span>
            }
           </td>
              <td>
              <div class="btn-group" role="group">
 <a asp-action="EditarUsuario" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">
       <i class="bi bi-pencil"></i> Editar
        </a>
      
          <form asp-action="ToggleUsuario" asp-route-id="@usuario.Id" method="post" class="d-inline">
        <button type="submit" class="btn btn-sm btn-outline-@(usuario.Activo ? "warning" : "success")"
      onclick="return confirm('@(usuario.Activo ? "¿Desactivar" : "¿Activar") usuario @usuario.Email?')">
        <i class="bi bi-@(usuario.Activo ? "pause" : "play")-circle"></i> 
     @(usuario.Activo ? "Desactivar" : "Activar")
 </button>
            </form>
  </div>
      </td>
</tr>
              }
           </tbody>
        </table>
    </div>
     </div>
        </div>
    </div>
</div>