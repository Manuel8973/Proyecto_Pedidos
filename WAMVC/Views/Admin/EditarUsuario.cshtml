@model WAMVC.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><i class="bi bi-person-gear"></i> Editar Usuario</h2>
            <a asp-action="Usuarios" class="btn btn-secondary">
   <i class="bi bi-arrow-left"></i> Volver a Usuarios
            </a>
     </div>

        @if (TempData["SuccessMessage"] != null)
     {
  <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
       <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  }

        <div class="card">
  <div class="card-header">
   <h5 class="mb-0">Información del Usuario</h5>
    </div>
  <div class="card-body">
     <form asp-action="EditarUsuario" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
       <input type="hidden" asp-for="Id" />

       <div class="mb-3">
    <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
<span asp-validation-for="Email" class="text-danger"></span>
    </div>

   <div class="mb-3">
   <label asp-for="Rol" class="form-label">Rol</label>
        <select asp-for="Rol" class="form-select">
  @foreach (var rol in ViewBag.Roles as List<string>)
 {
        <option value="@rol">@rol</option>
    }
    </select>
      <span asp-validation-for="Rol" class="text-danger"></span>
       </div>

        <div class="mb-3 form-check">
        <input asp-for="Activo" class="form-check-input" type="checkbox" />
          <label asp-for="Activo" class="form-check-label">Usuario Activo</label>
      <span asp-validation-for="Activo" class="text-danger"></span>
      </div>

    <div class="alert alert-info">
      <i class="bi bi-info-circle"></i> 
         <strong>Nota:</strong> La contraseña no se puede cambiar desde este formulario por seguridad.
    </div>

     <div class="d-grid gap-2 d-md-flex justify-content-md-end">
    <button type="submit" class="btn btn-primary">
          <i class="bi bi-check-lg"></i> Guardar Cambios
       </button>
     <a asp-action="Usuarios" class="btn btn-secondary">
       <i class="bi bi-x-lg"></i> Cancelar
         </a>
      </div>
   </form>
       </div>
</div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}